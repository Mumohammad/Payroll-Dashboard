# Supabase Auth — public values only (safe to expose in the browser bundle).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Prisma runtime database URL. For this standalone Node server, copy the Supavisor
# Session pooler URL (port 5432) from Supabase Project > Connect.
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-db-password>@<pooler-host>:5432/postgres"

# Prisma migration URL. Use a direct connection or Supavisor Session pooler URL
# (port 5432) from the same project. Never commit a real password.
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-db-password>@<pooler-host>:5432/postgres"

# For serverless runtime only, use the Transaction pooler URL for DATABASE_URL
# (port 6543) and append ?pgbouncer=true&connection_limit=1. Keep DIRECT_URL
# on a direct or Session pooler URL for migrations.
